# Supabase Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key
POSTGRES_URL=postgresql://user:password@host:port/database
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:port/database
POSTGRES_HOST=your-supabase-db-host
POSTGRES_USER=your-supabase-db-user
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_DATABASE=postgres

# Flask Configuration
SECRET_KEY=your-flask-secret-key-here

# Cloudinary Configuration (for profile pictures)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini API (Optional - for chatbot feature)
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-gemini-api-key

# Email Configuration (Optional - for password reset emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com
